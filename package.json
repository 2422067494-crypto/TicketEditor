{
  "name": "ticketeditor",
  "version": "1.4.0",
  "main": "main.js",
  "build": {
    "asar": false,
    "appId": "com.ticketeditor.app",
    "productName": "TicketEditor",
    "compression": "normal",
    "files": [
      "main.js",
      "preload.js",
      "package.json",

      "!**/*.zip",
      "!**/*.7z",
      "!**/*.rar",

      "!dist/**",
      "!out/**",
      "!release/**",
      "!win-unpacked/**",
      "!.git/**",
      "!.vscode/**",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/*.pyo",
      "!**/*.log",
      "!**/*.tmp"
    ],
    "extraResources": [
      { "from": "python", "to": "python" },
      { "from": "data.py", "to": "data.py" },
      { "from": "analysis.py", "to": "analysis.py" },
      { "from": "ticketeditor.html", "to": "ticketeditor.html" },
      { "from": "static", "to": "static" },
      { "from": "templates", "to": "templates" }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/uninstall.ico",
      "shortcutName": "TicketEditor",
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  }
}